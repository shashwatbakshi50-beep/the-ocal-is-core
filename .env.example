# Copy to .env (start.sh does this automatically) and adjust as needed.

# --- core database -----------------------------------------------------------
POSTGRES_USER=ocal
POSTGRES_PASSWORD=ocal
POSTGRES_DB=ocal
POSTGRES_PORT=5432

# --- auto-sync ---------------------------------------------------------------
# bbox as min_lon,min_lat,max_lon,max_lat (default: a Dutch village area)
SYNC_BBOX=5.20,52.00,5.23,52.02
H3_RESOLUTION=9
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=180
OVERPASS_RETRIES=4
# Base seconds for the exponential backoff between Overpass attempts.
OVERPASS_BACKOFF=10
# Total seconds to spend on Overpass before using the OSM API fallback.
OVERPASS_BUDGET=180
# Seconds to wait for a TCP/TLS connection before retrying.
OVERPASS_CONNECT_TIMEOUT=20
# Comma separated mirrors tried when the main endpoint is overloaded.
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
# When every Overpass instance is at capacity, read the bbox from the OSM API.
OSM_API_FALLBACK=1
OSM_API_URL=https://api.openstreetmap.org
OSM_API_RETRIES=3

# Overture Maps: leave OVERTURE_RELEASE empty to use the latest STAC release.
OVERTURE_ENABLED=1
OVERTURE_RELEASE=
# Max rows read per Overture theme per sync (0 disables the cap).
OVERTURE_LIMIT=50000
# Road history writes are committed every N features.
UPSERT_BATCH=500

# none | opentopodata | open-elevation
ELEVATION_PROVIDER=none

# Planet-scale PMTiles archive used by libheadway to cut regional extracts.
PMTILES_SOURCE_URL=

# Valhalla proxy (only reachable when the maps profile is running)
VALHALLA_URL=http://valhalla:8002
VALHALLA_DEFAULT_PROFILE=village_car

AUTO_SYNC_PORT=8000

# --- libheadway --------------------------------------------------------------
LIBHEADWAY_PORT=9123
HEADWAY_EXTRACT_SOURCE_URL=

# --- maps profile ------------------------------------------------------------
HEADWAY_PORT=8080

# --- billing profile ---------------------------------------------------------
LAGO_POSTGRES_USER=lago
LAGO_POSTGRES_PASSWORD=changeme
LAGO_POSTGRES_DB=lago
LAGO_SECRET_KEY_BASE=please-change-me
LAGO_API_PORT=3000
LAGO_FRONT_PORT=3001

# --- ai profile --------------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MEMORY_LIMIT=8g
